[sub_resource type="GDScript" id="GDScript_uwrxv"]
script/source = "extends Node2D


@export var ball_scene: PackedScene
@onready var player_scoreBoard: Node = $scoreBoardPlayer
@onready var bot_scoreBoard: Node = $scoreBoardBot
@export var enemyWall_spawn_delay: int = 1
@export var ball_spawn_delay: int = 1
var score: int
var screen_center: Vector2


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	screen_center = get_viewport_rect().size / 2
	new_game()


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	pass


func game_over() -> void:
	# stop all functions
	pass


func new_game() -> void:
	# initialize
	$PlayerWall.start()
	# set ball to track
	$EnemyWall.start() 
	$EnemyWall.ball = $Ball
	


func _on_goal_left_body_entered(body: Node2D) -> void:
	if body.name == \"Ball\":
		get_tree().get_first_node_in_group(\"camera\").set_shake(8.0, 0.3)
		bot_scoreBoard.increaseScore()
		print(\"! bot scored !\")
		$Ball.reset()


func _on_goal_right_body_entered(body: Node2D) -> void:
	if body.name == \"Ball\":
		get_tree().get_first_node_in_group(\"camera\").set_shake(8.0, 0.3)
		player_scoreBoard.increaseScore()
		print(\"! player scored !\")
		$Ball.reset()
"

[sub_resource type="GDScript" id="GDScript_yqjtg"]
script/source = "extends Camera2D

var shake_duration: float = 1
var shake_strength: float = 2
var shake_decay: float = 3


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if shake_duration > 0:
		shake_duration -= delta
		# Random offset each frame
		offset = Vector2(
			randf_range(-shake_strength, shake_strength),
			randf_range(-shake_strength, shake_strength) )
		# Decay the strength over time
		shake_strength = lerp(shake_strength, 0.0, shake_decay * delta)
	else:
		offset = Vector2.ZERO


func set_shake(duration: float, strength: float) -> void:
	shake_duration = duration
	shake_strength = strength
"

