[sub_resource type="GDScript" id="GDScript_uwrxv"]
script/source = "extends Node2D


@export var ball_scene: PackedScene
@onready var player_scoreBoard: Node = $scoreBoardPlayer
@onready var bot_scoreBoard: Node = $scoreBoardBot
@export var enemyWall_spawn_delay: int = 1
@export var ball_spawn_delay: int = 1
var score: int
var screen_center: Vector2


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	screen_center = get_viewport_rect().size / 2
	
	new_game()


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	pass


func game_over() -> void:
	# stop all functions
	pass


func new_game() -> void:
	# first, initialize ball to get enemyWall to track
	spawn_ball()
	
	$PlayerWall.start()
	$EnemyWall.start() 
	
	# delay before setting ball physics
	await get_tree().create_timer(ball_spawn_delay).timeout
	var ball: Node = get_node_or_null(\"Ball\")
	if ball:
		ball.start()
		ball.set_physics_process(true)


func _on_start_delay_timeout() -> void:
	pass


func spawn_ball() -> void:
	# initialize ball  node
	var ball: Node = ball_scene.instantiate()
	ball.name = \"Ball\"
	ball.position = screen_center
	add_child(ball)
	ball.get_node(\"CollisionShape2D\").disabled = true
	# call_deferred waits until next frame for the enemyWall to start tracking the ball
	$EnemyWall.ball = ball
	await get_tree().create_timer(ball_spawn_delay).timeout
	var new_ball: Node = get_node_or_null(\"Ball\")
	if new_ball:
		new_ball.start()
		new_ball.set_physics_process(true)
		new_ball.get_node(\"CollisionShape2D\").disabled = false
	print(\"ball spawned at \", ball.position)


func reset_ball() -> void:
	$EnemyWall.ball = null
	var ballToRemove: Node = get_node_or_null(\"Ball\")
	if ballToRemove:
		ballToRemove.set_physics_process(false)
		ballToRemove.queue_free()
		
	# small delay to get enemyWall to track new Ball
	await get_tree().process_frame
	print(\"ball reset\")
	spawn_ball()
	# delay before setting ball physics
	await get_tree().create_timer(ball_spawn_delay).timeout
	var ball: Node = get_node_or_null(\"Ball\")
	if ball:
		ball.start()
		ball.set_physics_process(true)


func tempDisableGoals() -> void:
	# supposed to deal with the immediate score by bot goal 
	print(\"temp disabling goals\")
	$Goal_Left.monitoring = false
	$Goal_Right.monitoring = false
	await get_tree().process_frame
	$Goal_Left.monitoring = true
	$Goal_Right.monitoring = true
	print(\"goals enabled\")


func _on_goal_left_body_entered(body: Node2D) -> void:
	if body.name == \"Ball\":
		bot_scoreBoard.increaseScore()
		print(\"! bot scored !\")
		reset_ball()


func _on_goal_right_body_entered(body: Node2D) -> void:
	if body.name == \"Ball\":
		player_scoreBoard.increaseScore()
		print(\"! player scored !\")
		reset_ball()
"

