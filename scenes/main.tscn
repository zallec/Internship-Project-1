[sub_resource type="GDScript" id="GDScript_uwrxv"]
script/source = "extends Node2D


var score: int
@export var ball_scene: PackedScene
@onready var scoreBoard: Node = $scoreBoard
var screen_center: Vector2
signal ball_spawned(ball: Node)


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	screen_center = $Camera2D.global_position
	new_game()


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	pass


func game_over() -> void:
	# stop all functions
	pass


func new_game() -> void:
	score = 0
	$Cursor.start()
	$StartDelay.start()


func _on_start_delay_timeout() -> void:
	$PlayerWall.start()
	$EnemyWall.start() 


func spawn_ball() -> void:
	var ball: Node = ball_scene.instantiate()
	ball.name = \"Ball\"
	add_child(ball)
	ball._start()
	emit_signal(\"ball_spawned\", ball)
	

func reset_ball() -> void:
	var ballToRemove: Node = get_node_or_null(\"Ball\")
	if ballToRemove:
		ballToRemove.queue_free()
		# small delay to get enemyWall to track new Ball
		await get_tree().process_frame
		await get_tree().process_frame
	spawn_ball()


func _on_goal_left_body_entered(body: Node2D) -> void:
	if body.name == \"Ball\":
		#scoreBoard.increaseScore() for enemy controller
		reset_ball()


func _on_goal_right_body_entered(body: Node2D) -> void:
	if body.name == \"Ball\":
		scoreBoard.increaseScore()
		reset_ball()
"

